# Drop the two `handle*` blocks below into your dashboard's Caddyfile
# block (above or below the existing `reverse_proxy 127.0.0.1:3000`
# directive). They route browser traffic to the gateway and to go2rtc.
#
# Browser -> Caddy (TLS) -> 127.0.0.1:1984 (go2rtc)         WS upgrade
# Browser -> Caddy (TLS) -> 127.0.0.1:8002 (kasa-tapo-services)
#
# All other dashboard requests still go to Next.js on :3000, which
# proxies /api/* to FastAPI on :8001.

# go2rtc - WebSocket upgrade for the MSE feed.
#
# Also serves the WebRTC signaling endpoint (POST /api/webrtc?src=<stream>)
# on the same port. The actual WebRTC media stream does NOT flow through
# Caddy — it goes directly to go2rtc on TCP port 8555 (see below) so the
# reverse proxy doesn't have to learn how to forward DTLS/SRTP frames.
handle_path /streams/* {
    reverse_proxy 127.0.0.1:1984
}

# WebRTC media transport (TCP-only).
#
# kasa-tapo-bootstrap-go2rtc renders `webrtc.listen: '0.0.0.0:8555/tcp'`
# by default, so the dashboard host must accept inbound TCP on 8555 from
# any Tailscale peer that will view a stream. There is NO Caddy block
# here — the browser opens a raw TCP connection to <dashboard-host>:8555
# carrying WebRTC's own DTLS/SRTP framing, not HTTP, so a reverse proxy
# would only get in the way.
#
# Set GO2RTC_WEBRTC_HOST in the kasa-tapo-services .env to the dashboard
# host's Tailscale MagicDNS name (e.g. gaia.tail6a1dd7.ts.net); the
# bootstrap renders it into `webrtc.candidates` so the browser knows
# where to dial.
#
# To audit:  ss -tlnp | grep 8555         # go2rtc listening
# To probe:  nc -zv <dashboard-host> 8555 # peer reachable

# Direct gateway access for development. In production the dashboard's
# aggregator forwards /api/equipment/{id}/control/* to the gateway
# server-side (see ac-organic-lab/api/app/control.py); this block is a
# pure debugging escape hatch and can be removed for a hardened deploy.
handle /api/cameras/* {
    reverse_proxy 127.0.0.1:8002
}
handle /api/plugs/* {
    reverse_proxy 127.0.0.1:8002
}
