# Devices hosted by this gateway. One file per gateway-host (the dashboard
# server, typically). The gateway loads this file on startup and exposes a
# STATUS_SPEC v1.0 surface per device:
#
#   /cameras/{id}/{,/health,/status,/control/*}        for kind: camera
#   /plugs/{id}/{,/health,/status,/control/*}          for kind: smart_plug, power_strip
#
# The matching ac-organic-lab `equipment.yaml` entry sets:
#
#   adapter:    http
#   protocol:   "1.0"
#   base_url:   http://<gateway-host>:8002
#   status_path: /cameras/<id>/status   (for cameras)
#                /plugs/<id>/status     (for plugs)
#
# Hostnames here MUST be the device's address on the lab **Wi-Fi** network
# (172.31.x.x DHCP lease in this lab) - NOT the dashboard host's tailnet IP,
# and NOT an address on the wired network. Cameras and Kasa plugs expose RTSP,
# ONVIF, and the proprietary Kasa protocol over Wi-Fi only; the gateway host
# is multi-homed and reaches them exclusively through its wireless interface.
# Verify with `ip route get <host>` on the gateway host - it must name the
# wireless device (wlp9s0 here), not the wired one.
#
# These are DHCP leases, so an address can move. If a device that used to work
# goes unreachable, re-check its current address in the Tapo / Kasa app before
# assuming the hardware failed.
#
# Real credentials live in `.env` (gitignored) using the variable name
# convention documented in `.env.example`.

devices:
  # --- Tapo C245D dual-lens PTZ camera --------------------------------
  - id: cam_lab499_west
    name: Lab 499 (West) Camera
    kind: camera
    host: 172.31.60.42                  # <-- replace with the real Wi-Fi IP
    onvif_port: 2020                    # default for Tapo C-series
    rtsp_port: 554
    # One entry per physical lens. The C245D has wide + tele; older Tapo
    # PTZ models (C200/C210/C220) just have one lens - omit the second.
    #
    # Per TP-Link's RTSP/ONVIF FAQ for dual-lens models, the lenses live
    # at *non-adjacent* RTSP paths:
    #   wide-angle: /stream1 (HD)  /stream2 (SD)
    #   telephoto:  /stream6 (HD)  /stream7 (SD)
    # Single-lens models (C100, C200/C210/C220) only expose /stream1 and
    # /stream2 - wire just /stream1 as the single lens.
    # Verify with `ffprobe rtsp://user:pass@host:554/stream1`.
    lenses:
      - { id: wide, label: Wide, rtsp_path: stream1 }
      - { id: tele, label: Tele, rtsp_path: stream6 }
    # Optional: limit which preset slots the gateway will use when saving.
    # Tapo cameras typically support 8 named presets. Uncomment to cap.
    # max_presets: 8
    # Optional: where snapshots / recordings land on disk. Per-lens
    # subdirectories are created automatically. Defaults to
    # ${KASA_TAPO_MEDIA_ROOT}/snapshots|recordings/<camera_id>/.
    # media:
    #   snapshots_dir: ~/kasa-tapo-media/snapshots/cam_lab499_west
    #   recordings_dir: /mnt/lab-storage/video/cam_lab499_west

  # --- Fixed single-lens camera, e.g. Tapo C100 / C110 ---------------
  # A fixed camera has no ONVIF PTZ service. Nothing extra to declare: the
  # gateway detects it, reports no presets, and omits ptz / preset/* from
  # allowed_actions rather than advertising an action the hardware refuses.
  # - id: cam_storage
  #   name: Storage Camera
  #   kind: camera
  #   host: 172.31.60.43
  #   onvif_port: 2020
  #   lenses:
  #     - { id: main, label: Main, rtsp_path: stream1 }

  # --- Kasa HS300 power strip (6 outlets) -----------------------------
  # - id: plug_hotplate_strip
  #   name: HTE Bench Hotplate Strip
  #   kind: power_strip
  #   host: 172.31.60.51
  #   outlets:
  #     - { index: 0, label: Hotplate A }
  #     - { index: 1, label: Hotplate B }
  #     - { index: 2, label: Stirrer }
  #     - { index: 3, label: "(spare)" }
  #     - { index: 4, label: "(spare)" }
  #     - { index: 5, label: "(spare)" }

