# Devices hosted by this gateway. One file per gateway-host (the dashboard
# server, typically). The gateway loads this file on startup and exposes a
# STATUS_SPEC v1.0 surface per device:
#
#   /cameras/{id}/{,/health,/status,/control/*}        for kind: camera
#   /plugs/{id}/{,/health,/status,/control/*}          for kind: smart_plug, power_strip
#
# The matching ac-organic-lab `equipment.yaml` entry sets:
#
#   adapter:    http
#   protocol:   "1.0"
#   base_url:   http://<gateway-host>:8002
#   status_path: /cameras/<id>/status   (for cameras)
#                /plugs/<id>/status     (for plugs)
#
# Hostnames here MUST be the device's lab-LAN address (typically a 192.168.x
# DHCP lease) - NOT the dashboard host's tailnet IP. Cameras and Kasa plugs
# expose RTSP and the proprietary discover protocol on the lab LAN only.
#
# Real credentials live in `.env` (gitignored) using the variable name
# convention documented in `.env.example`.

devices:
  # --- Tapo C245D dual-lens PTZ camera --------------------------------
  - id: cam_lab499_west
    name: Lab 499 (West) Camera
    kind: camera
    host: 192.168.1.42                  # <-- replace with real LAN IP
    onvif_port: 2020                    # default for Tapo C-series
    rtsp_port: 554
    # One entry per physical lens. The C245D has wide + tele; older Tapo
    # PTZ models (C200/C210/C220) just have one lens - omit the second.
    #
    # Per TP-Link's RTSP/ONVIF FAQ for dual-lens models, the lenses live
    # at *non-adjacent* RTSP paths:
    #   wide-angle: /stream1 (HD)  /stream2 (SD)
    #   telephoto:  /stream6 (HD)  /stream7 (SD)
    # Single-lens models (C200/C210/C220) only expose /stream1 and /stream2.
    # Verify with `ffprobe rtsp://user:pass@host:554/stream1`.
    lenses:
      - { id: wide, label: Wide, rtsp_path: stream1 }
      - { id: tele, label: Tele, rtsp_path: stream6 }
    # Optional: limit which preset slots the gateway will use when saving.
    # Tapo cameras typically support 8 named presets. Uncomment to cap.
    # max_presets: 8
    # Optional: where snapshots / recordings land on disk. Per-lens
    # subdirectories are created automatically. Defaults to
    # ${KASA_TAPO_MEDIA_ROOT}/snapshots|recordings/<camera_id>/.
    # media:
    #   snapshots_dir: ~/kasa-tapo-media/snapshots/cam_lab499_west
    #   recordings_dir: /mnt/lab-storage/video/cam_lab499_west

